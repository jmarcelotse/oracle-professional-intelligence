{
  "mcpServers": {
    "oracle-filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/ABSOLUTE/PATH/oracle-professional-intelligence"]
    },
    "oracle-git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "/ABSOLUTE/PATH/oracle-professional-intelligence"]
    },
    "oracle-github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_REPLACE_ME"
      }
    },
    "oracle-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://oracle:oracle@localhost:5432/oracle_professional_intelligence"
      ]
    },
    "oracle-obsidian": {
      "command": "npx",
      "args": ["-y", "mcp-obsidian", "/ABSOLUTE/PATH/Obsidian/Oracle-Knowledge"]
    },
    "oracle-fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "oracle-memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  }
}
